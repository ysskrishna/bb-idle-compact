{
  "name": "bb-idle-compact",
  "version": "0.1.1",
  "type": "module",
  "description": "Compacts large idle Claude Code and Codex threads before their prompt cache expires, so coming back does not re-read the whole context without the cache.",
  "license": "MIT",
  "author": "YSS Krishna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysskrishna/bb-idle-compact.git"
  },
  "homepage": "https://github.com/ysskrishna/bb-idle-compact#readme",
  "bugs": {
    "url": "https://github.com/ysskrishna/bb-idle-compact/issues"
  },
  "engines": {
    "bb": ">=0.50.1",
    "bbPluginSdk": ">=0.6.157"
  },
  "bb": {
    "name": "Idle Compact",
    "description": "Compacts large idle Claude Code and Codex threads before their prompt cache expires, so coming back does not re-read the whole context without the cache.",
    "branding": {
      "icon": "Archive"
    },
    "app": "./app.tsx",
    "server": "./src/server.ts"
  },
  "keywords": [
    "bb-plugin",
    "compact",
    "compaction",
    "prompt-cache",
    "cache",
    "tokens",
    "usage",
    "context",
    "claude-code",
    "codex"
  ],
  "files": ["dist", "src", "!src/**/*.test.*", "components", "lib", "app.tsx", "tsconfig.json", "README.md", "LICENSE"],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bb plugin build",
    "check": "npm run lint && npm run format:check && npm run knip && npm run typecheck && npm test && npm run test:scripts && npm run build && node scripts/check-app-bundle.mjs",
    "test": "vitest run",
    "test:scripts": "node --test scripts/release/*.test.mjs scripts/e2e/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . && node scripts/check-file-sizes.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "knip": "knip --no-config-hints",
    "prepare": "lefthook install",
    "e2e:smoke": "node scripts/e2e/smoke.mjs",
    "e2e:serve": "node scripts/e2e/serve.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@get-bb/plugin-sdk": "0.6.157",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "bb-app": "0.50.1",
    "better-sqlite3": "^12.0.0",
    "clsx": "^2.1.1",
    "hono": "^4.11.9",
    "knip": "^5.88.1",
    "lefthook": "^2.2.1",
    "react": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
